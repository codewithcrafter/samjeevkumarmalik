# ==============================================================================
# SANJEEV KUMAR MALIK - UNIVERSAL CLEAN URL CONFIG (ROOT & SUBFOLDER COMPATIBLE)
# ==============================================================================

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Production Canonical Non-WWW to WWW Redirect (Active only for live apex domain)
  RewriteCond %{HTTP_HOST} ^sanjeevkumarmalik\.in$ [NC]
  RewriteRule ^(.*)$ https://www.sanjeevkumarmalik.in/$1 [R=301,L]

  # 1. Admin Portal Clean URLs
  RewriteRule ^admin/?$ admin/index.php [NC,L]
  RewriteRule ^admin/login/?$ admin/login.php [NC,L]
  RewriteRule ^admin/logout/?$ admin/logout.php [NC,L]
  RewriteRule ^admin/create-blog/?$ admin/create-blog.php [NC,L]
  RewriteRule ^admin/edit-blog/?$ admin/edit-blog.php [NC,QSA,L]
  RewriteRule ^admin/delete-blog/?$ admin/delete-blog.php [NC,QSA,L]

  # 2. Dynamic Blogs Listing & Single Articles (Must precede -d check to ensure dynamic DB-driven blogs)
  RewriteRule ^blogs/?$ blogs.php [NC,L]
  RewriteRule ^blogs/([^/]+)/?$ blog.php?slug=$1 [NC,QSA,L]

  # 3. Directly serve existing files and directories (CSS, JS, images, txt, xml, md)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Clean URLs for .php files
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [NC,L]

  # 5. Clean URLs for .html files (e.g. /about-sanjeev-kumar-malik, /contact-us, /services)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [NC,L]

  # 6. Clean URLs for multi-segment routes (e.g. /services/wordpress-web-development)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]

  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [NC,L]
</IfModule>

# MIME Types for AI / Text / Markdown Discoverability
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType text/markdown .md
</IfModule>

# Browser Caching & Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/markdown "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
